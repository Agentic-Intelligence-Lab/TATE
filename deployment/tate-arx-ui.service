[Unit]
Description=TATE stack-cube ARX EEF control console
After=network-online.target

[Service]
Type=simple
# Default clone location: /home/qijun/TATE.  Override TATE_APP_ROOT only when
# installing a customized unit for another checkout location.
WorkingDirectory=%h/TATE
Environment=TATE_APP_ROOT=%h/TATE
ExecStart=%h/TATE/deployment/run_ui.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target
